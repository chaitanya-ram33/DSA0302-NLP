        "\n",
        "import pandas as pd\n",
        "\n",
        "words = [\"writes\", \"writing\", \"written\"]\n",
        "\n",
        "# Finite-state transition model\n",
        "transitions = {\n",
        "    \"START\": \"MATCH\",\n",
        "    \"MATCH_REGULAR_S\": \"NORMALIZE\",\n",
        "    \"MATCH_REGULAR_ING\": \"NORMALIZE\",\n",
        "    \"MATCH_IRREGULAR\": \"NORMALIZE\"\n",
        "}\n",
        "\n",
        "def parse_word(word):\n",
        "    path = [\"S0:START\", \"S1:MATCH\"]\n",
        "\n",
        "    if word == \"writes\":\n",
        "        components = \"write + -s\"\n",
        "        pattern = \"Regular inflection\"\n",
        "        rule = \"Remove -s\"\n",
        "        root = \"write\"\n",
        "        path.append(\"S2a:REGULAR_S\")\n",
        "\n",
        "    elif word == \"writing\":\n",
        "        components = \"write + -ing\"\n",
        "        pattern = \"Regular inflection\"\n",
        "        rule = \"Remove -ing; restore final e\"\n",
        "        root = \"write\"\n",
        "        path.append(\"S2b:REGULAR_ING\")\n",
        "\n",
        "    elif word == \"written\":\n",
        "        components = \"irregular participle of write\"\n",
        "        pattern = \"Irregular inflection\"\n",
        "        rule = \"Lexicon lookup: written -> write\"\n",
        "        root = \"write\"\n",
        "        path.append(\"S2c:IRREGULAR\")\n",
        "\n",
        "    else:\n",
        "        components = word\n",
        "        pattern = \"Unknown\"\n",
        "        rule = \"No rule matched\"\n",
        "        root = word\n",
        "        path.append(\"S2x:UNKNOWN\")\n",
        "\n",
        "    path.append(\"S3:NORMALIZE\")\n",
        "\n",
        "    return {\n",
        "        \"Original Word\": word,\n",
        "        \"Morphological Components\": components,\n",
        "        \"Pattern\": pattern,\n",
        "        \"Rule Applied\": rule,\n",
        "        \"Root\": root,\n",
        "        \"Normalized Form\": root,\n",
        "        \"State Transition Path\": \" -> \".join(path)\n",
        "    }\n",
        "\n",
        "df = pd.DataFrame([parse_word(w) for w in words])\n",
        "print(df.to_string(index=False))\n"
