        "\n",
        "import pandas as pd\n",
        "\n",
        "words = [\"connected\", \"connecting\", \"connection\"]\n",
        "\n",
        "def analyze_word(word):\n",
        "    if word == \"connected\":\n",
        "        return \"connect\", \"-ed\", \"Inflectional\", \"connect\"\n",
        "\n",
        "    elif word == \"connecting\":\n",
        "        return \"connect\", \"-ing\", \"Inflectional\", \"connect\"\n",
        "\n",
        "    elif word == \"connection\":\n",
        "        return \"connect\", \"-ion\", \"Derivational\", \"connect\"\n",
        "\n",
        "    return word, \"None\", \"Unclassified\", word\n",
        "\n",
        "results = []\n",
        "\n",
        "for word in words:\n",
        "    root, suffix, category, normalized = analyze_word(word)\n",
        "\n",
        "    results.append({\n",
        "        \"Original Word\": word,\n",
        "        \"Root\": root,\n",
        "        \"Suffix\": suffix,\n",
        "        \"Transformation\": category,\n",
        "        \"Normalized Form\": normalized\n",
        "    })\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "print(df.to_string(index=False))\n"
