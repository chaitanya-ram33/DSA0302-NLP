        "\n",
        "import pandas as pd\n",
        "from nltk.stem import PorterStemmer\n",
        "\n",
        "stemmer = PorterStemmer()\n",
        "\n",
        "words = [\"relational\", \"relation\", \"relate\"]\n",
        "\n",
        "# Trace the relevant Porter rules for these specific inputs.\n",
        "def porter_trace(word):\n",
        "    steps = []\n",
        "\n",
        "    if word == \"relational\":\n",
        "        steps.append(\"Original: relational\")\n",
        "        steps.append(\"Step 2: ational -> ate: relate\")\n",
        "        steps.append(\"Step 5: remove final e: relat\")\n",
        "\n",
        "    elif word == \"relation\":\n",
        "        steps.append(\"Original: relation\")\n",
        "        steps.append(\"Step 4: remove ion: relat\")\n",
        "\n",
        "    elif word == \"relate\":\n",
        "        steps.append(\"Original: relate\")\n",
        "        steps.append(\"Step 5: remove final e: relat\")\n",
        "\n",
        "    final_stem = stemmer.stem(word)\n",
        "\n",
        "    return {\n",
        "        \"Original Word\": word,\n",
        "        \"Applied Rules\": \" | \".join(steps[1:]),\n",
        "        \"Intermediate Forms\": \" -> \".join(steps),\n",
        "        \"Porter Stem\": final_stem\n",
        "    }\n",
        "\n",
        "results = [porter_trace(word) for word in words]\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "print(df.to_string(index=False))\n"
